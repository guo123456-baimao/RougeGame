/* ============================================================
   components.uss — 组件类
   所有类必须复用 tokens.uss 里定义的色彩 / 间距 / 字号，
   不允许出现新的裸色值。
   ============================================================ */

/* ---------- 面板 ---------- */
.panel {
    width: 440px;
    background-color: rgb(21, 24, 29);
    border-width: 1px;
    border-color: rgb(42, 47, 58);
    border-radius: 14px;
    padding: 24px;
    flex-direction: column;
}

.panel__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(35, 40, 51);
}

.panel__title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(233, 235, 240);
    letter-spacing: 0.5px;
}

/* ---------- 图标按钮 ---------- */
.icon-btn {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background-color: rgb(28, 32, 42);
    border-width: 1px;
    border-color: rgb(42, 47, 58);
    align-items: center;
    justify-content: center;
    font-size: 13px;
    color: rgb(154, 163, 178);
    scale: 1;
    translate: 0 0;
    transition-property: background-color, border-color, color, scale, translate;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}
.icon-btn:hover {
    background-color: rgb(35, 40, 51);
    color: rgb(233, 235, 240);
    scale: 1.12;
}
.icon-btn:active { scale: 0.92; }

/* 返回按钮：像素图标。源图集是 Multiple 切片，USS 引用不了子 sprite，
   所以把图集第一个 sprite（骷髅，30x30）导出成了独立的 Back.png（含 2px 透明边）。
   之前按钮上的 "←" 文字在中文字体里没有字形，渲染不出来，已从 UXML 移除。 */
.icon-btn--back {
    background-image: url("project://database/Assets/Sprites/Icons/Back.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* ---------- 标签页 ---------- */
.tabs {
    flex-direction: row;
    gap: 24px;
    padding-top: 16px;
    padding-bottom: 20px;
}
.tab {
    font-size: 13px;
    color: rgb(124, 135, 151);
    padding-bottom: 8px;
    translate: 0 0;
    transition-property: color, translate;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}
.tab:hover { color: rgb(184, 192, 206); translate: 0 -1px; }
.tab--active {
    color: rgb(216, 166, 87);
    -unity-font-style: bold;
    border-bottom-width: 2px;
    border-bottom-color: rgb(216, 166, 87);
}

/* ---------- 键值行 ---------- */
.rows {
    flex-direction: column;
    gap: 1px;
    background-color: rgb(35, 40, 51);
    border-radius: 6px;
}
.kv {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgb(26, 30, 38);
    padding: 12px 16px;
    translate: 0 0;
    transition-property: background-color, translate;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}
.kv:hover { background-color: rgb(31, 36, 46); translate: 4px 0; }
.kv__k { font-size: 13px; color: rgb(143, 153, 169); }
.kv__v { font-size: 15px; -unity-font-style: bold; color: rgb(233, 235, 240); }
.kv__v--up   { color: rgb(95, 191, 127); }
.kv__v--down { color: rgb(224, 91, 91); }

/* ---------- 进度条 ---------- */
.xp { flex-direction: column; gap: 8px; padding-top: 20px; }
.xp__line { flex-direction: row; justify-content: space-between; }
.xp__label { font-size: 12px; color: rgb(143, 153, 169); }
.xp__num   { font-size: 12px; color: rgb(184, 192, 206); }
.track {
    height: 6px;
    background-color: rgb(35, 40, 51);
    border-radius: 3px;
}
.track__fill {
    height: 6px;
    background-color: rgb(216, 166, 87);
    border-radius: 3px;
}

/* ---------- 按钮 ---------- */
.footer {
    flex-direction: row;
    justify-content: flex-end;
    gap: 12px;
    padding-top: 24px;
}
.btn {
    height: 38px;
    padding-left: 20px;
    padding-right: 20px;
    border-radius: 8px;
    font-size: 13px;
    -unity-font-style: bold;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    scale: 1;
    translate: 0 0;
    transition-property: background-color, border-color, color, scale, translate;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}
.btn:hover  { scale: 1.04; translate: 0 -2px; }
.btn:active { scale: 0.96; translate: 0 0; }
.btn--primary {
    background-color: rgb(216, 166, 87);
    color: rgb(26, 18, 4);
    border-color: rgb(216, 166, 87);
}
.btn--primary:hover {
    background-color: rgb(229, 184, 108);
    border-color: rgb(229, 184, 108);
}
.btn--ghost {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(184, 192, 206);
    border-color: rgb(58, 65, 80);
}
.btn--ghost:hover {
    border-color: rgb(93, 101, 115);
    color: rgb(233, 235, 240);
}
.btn--danger {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(224, 91, 91);
    border-color: rgb(74, 44, 44);
}
.btn--danger:hover { background-color: rgb(42, 26, 26); }

/* ============================================================
   叠层伪造投影（2021.3 不支持 box-shadow）
   外层 = 半透明黑底板（.bg-shadow 的同色值），内层上移 4px，
   底部露出的那条黑边即为投影。translate 不参与布局计算，
   不会挤动兄弟元素。
   注意：这是容器，flex-direction 必须显式给 column，
   否则子元素的百分比宽度 / 拉伸行为会和原来不一致。
   ============================================================ */
.lift {
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 8px;
    overflow: visible;
}
.lift > * {
    translate: 0 -4px;
    transition-property: translate;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

/* 面板：原来 .page__panel 带 flex-grow: 1，包层后要由外层继续撑满 */
.lift--panel { flex-grow: 1; border-radius: 8px; }

/* 卡片 / 方块这类可点元素才跟随 hover 抬起并加深投影；
   面板、底栏这类大块不参与，否则鼠标一扫整页都在跳。 */
.lift--card:hover { background-color: rgba(0, 0, 0, 0.78); }
.lift--card:hover > * { translate: 0 -7px; }
.lift--tile:hover { background-color: rgba(0, 0, 0, 0.78); }
.lift--tile:hover > * { translate: 0 -7px; }

/* 小尺寸元素用 2px 档，避免投影过重 */
.lift--sm { border-radius: 6px; }
.lift--sm > * { translate: 0 -2px; }
.lift--sm:hover > * { translate: 0 -4px; }
