<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/ui-tokens.uss?fileID=7433441132597879392&amp;guid=caeb910a7f9ceac449cad2172608b7e6&amp;type=3#ui-tokens" />
    <Style src="project://database/Assets/UI/ui-components.uss?fileID=7433441132597879392&amp;guid=e4db1021f16cd174f8a38fd34fa4226c&amp;type=3#ui-components" />
    <Style src="project://database/Assets/UI/shop-page.uss?fileID=7433441132597879392&amp;guid=86f4f66929acf364f8f32a9ea1702aba&amp;type=3#shop-page" />
    <ui:VisualElement name="CardRoot" class="lift lift--card">
        <ui:VisualElement name="Card" class="card" style="background-image: url(&quot;project://database/Assets/Sprites/UI/Sprite%20sheet%20for%20Basic%20Pack.png?fileID=-264951533&amp;guid=54f4a82656dc18d48ad468e0bc6893e4&amp;type=3#Sprite sheet for Basic Pack_83&quot;); -unity-background-scale-mode: scale-and-crop; -unity-slice-left: 2; -unity-slice-top: 2; -unity-slice-right: 2; -unity-slice-bottom: 2; -unity-background-image-tint-color: rgb(86, 120, 231);">
            <ui:VisualElement name="CardTop" class="card__top">
                <ui:VisualElement name="IconBox" class="card__icon">
                    <ui:Image name="Icon" scale-mode="scale-to-fit" class="card__icon-image" style="background-image: url(&quot;project://database/Assets/Sprites/UI/Sprite%20sheet%20for%20Basic%20Pack.png?fileID=1526056683&amp;guid=54f4a82656dc18d48ad468e0bc6893e4&amp;type=3#Sprite sheet for Basic Pack_22&quot;); -unity-background-scale-mode: scale-and-crop; -unity-slice-left: 4; -unity-slice-top: 4; -unity-slice-right: 4; -unity-slice-bottom: 4;" />
                </ui:VisualElement>
                <ui:VisualElement name="Head" class="card__head">
                    <ui:Label name="NameLabel" text="商品名称" class="card__name" style="font-size: 18px;" />
                    <ui:Label name="TypeLabel" text="属性强化" class="card__type" style="color: rgb(255, 255, 255); font-size: 15px;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="DescLabel" text="属性加成 +10" class="card__desc" style="font-size: 18px; background-image: url(&quot;project://database/Assets/Sprites/UI/Sprite%20sheet%20for%20Basic%20Pack.png?fileID=-1582144375&amp;guid=54f4a82656dc18d48ad468e0bc6893e4&amp;type=3#Sprite sheet for Basic Pack_1&quot;); -unity-slice-left: 4; -unity-slice-top: 4; -unity-slice-right: 4; -unity-slice-bottom: 4; color: rgb(191, 19, 0);" />
            <ui:VisualElement name="Foot" class="card__foot">
                <ui:Label name="PriceLabel" text="价格 60" class="card__price" style="font-size: 15px;" />
                <ui:Button name="ActionButton" text="购买" class="btn card__action" style="background-image: url(&quot;project://database/Assets/Sprites/UI/Sprite%20sheet%20for%20Basic%20Pack.png?fileID=1451439134&amp;guid=54f4a82656dc18d48ad468e0bc6893e4&amp;type=3#Sprite sheet for Basic Pack_55&quot;); -unity-background-scale-mode: scale-and-crop; -unity-slice-left: 2; -unity-slice-top: 2; -unity-slice-right: 2; -unity-slice-bottom: 2; -unity-font-style: normal; font-size: 15px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
