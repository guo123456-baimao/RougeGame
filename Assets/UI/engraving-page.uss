/* ============================================================
   engraving-page.uss — 铭文强化页组件
   所有色值 / 间距 / 字号 / 圆角均取自 ui-tokens.uss
   ============================================================ */

/* ---------- 页面外壳 ---------- */
.page {
    width: 100%;
    height: 100%;
    background-color: rgb(11, 13, 16);
    /* 细颗粒噪点，与 shop-page / character-page 保持同一张图、同一套参数 */
    background-image: url("project://database/Assets/UI/Textures/noise-mid.png");
    -unity-background-scale-mode: scale-and-crop;
    padding: 24px;
    flex-direction: column;
}

/* 内容面板：把整页内容收进一块带边框的台面 */
.page__panel {
    flex-grow: 1;
    flex-direction: column;
    gap: 16px;
    padding: 16px;
    background-color: rgb(21, 24, 29);
    border-width: 1px;
    border-color: rgb(58, 65, 80);
    border-radius: 8px;
}
.page__stripe {
    height: 4px;
    border-radius: 3px;
    background-color: rgb(216, 166, 87);
    margin-bottom: 8px;
}

.page__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(35, 40, 51);
}
.page__left { flex-direction: row; align-items: center; gap: 12px; }
.page__right { flex-direction: row; align-items: center; gap: 12px; }
.page__title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(233, 235, 240);
}

/* ---------- 顶栏胶囊（金币 / 已装备） ---------- */
.pill {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-radius: 6px;
    background-color: rgb(28, 32, 42);
    border-width: 1px;
    border-color: rgb(42, 47, 58);
    scale: 1;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}
.pill:hover { scale: 1.03; }
.pill__k { font-size: 11px; color: rgb(143, 153, 169); }
.pill__v { font-size: 13px; -unity-font-style: bold; color: rgb(216, 166, 87); }
.pill__v--plain { color: rgb(233, 235, 240); }
/* 金币不足 / 装备槽已满时的红闪：只换颜色，不改粗细，避免闪烁时头部抖动 */
.pill--alert { border-color: rgb(224, 91, 91); }
.pill--alert-dim { border-color: rgb(42, 47, 58); }
.pill__v--alert { color: rgb(224, 91, 91); }

/* ---------- 铭文卡片网格（flex-wrap 模拟 grid） ---------- */
.grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    /* 卡片下方多出 4px 投影外溢，行间距从 16 加到 20 留位 */
    gap: 20px;
    padding-top: 16px;
    flex-grow: 1;
}

/* 卡片的宽度转移到投影层：.lift--card 才是 .grid 的 flex item，
   百分比基准随之改变；卡片本体改为撑满外层，min-width 必须清零。 */
.lift--card { width: 32%; min-width: 300px; }
.card {
    width: 100%;
    min-width: 0;
    translate: 0 -4px;
    scale: 1;
    transition-property: background-color, border-color, scale, translate;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
    flex-direction: column;
    gap: 8px;
    background-color: rgb(28, 32, 42);
    border-width: 1px;
    border-color: rgb(42, 47, 58);
    border-radius: 8px;
    padding: 16px;
}
.card:hover { scale: 1.015; }
.card--equipped { border-color: rgb(216, 166, 87); }

.card__top { flex-direction: row; align-items: center; gap: 12px; }
.card__icon {
    width: 48px;
    height: 48px;
    border-radius: 6px;
    background-color: rgb(35, 40, 51);
    border-width: 1px;
    border-color: rgb(58, 65, 80);
    align-items: center;
    justify-content: center;
    overflow: hidden;
}
.card__icon-image { width: 100%; height: 100%; }

.card__head { flex-direction: column; gap: 4px; }
.card__name { font-size: 13px; -unity-font-style: bold; color: rgb(233, 235, 240); }
.card__state { font-size: 11px; color: rgb(143, 153, 169); }

.card__effect { font-size: 11px; color: rgb(95, 191, 127); }
.card__curse { font-size: 11px; color: rgb(224, 91, 91); }
.card__curse--none { color: rgb(143, 153, 169); }

.card__action { margin-top: 4px; }

/* ---------- 底部已装备栏 ---------- */
.bottombar {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    background-color: rgb(26, 30, 38);
    border-width: 1px;
    border-color: rgb(216, 166, 87);
    border-radius: 8px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
}
.bottombar__label { font-size: 11px; color: rgb(143, 153, 169); }
.bottombar__hint { font-size: 11px; color: rgb(143, 153, 169); margin-left: auto; }

.slot-row { flex-direction: row; align-items: center; gap: 8px; }

.slot {
    width: 32px;
    height: 32px;
    padding: 4px;
    border-radius: 6px;
    background-color: rgb(35, 40, 51);
    border-width: 1px;
    border-color: rgb(58, 65, 80);
    align-items: center;
    justify-content: center;
}
.slot__icon { width: 100%; height: 100%; }
.slot:hover { border-color: rgb(93, 101, 115); }
.bottombar__hint--active { color: rgb(216, 166, 87); }
.bottombar__hint--warn { color: rgb(224, 91, 91); }
.slot--filled {
    background-color: rgb(28, 32, 42);
    border-color: rgb(216, 166, 87);
    color: rgb(216, 166, 87);
    font-size: 11px;
}
